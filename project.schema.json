{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDCAD project v1",
  "type": "object",
  "properties": {
    "project_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "enum": [
        "mm",
        "cm",
        "m",
        "in"
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string",
            "pattern": "^="
          }
        ]
      }
    },
    "layers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "segments": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "solid": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "enabled": {
            "type": "boolean"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^="
                }
              ]
            }
          },
          "placement": {
            "type": "object",
            "properties": {
              "translate": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "pattern": "^="
                    }
                  ]
                },
                "minItems": 3,
                "maxItems": 3
              },
              "rotate": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "pattern": "^="
                    }
                  ]
                },
                "minItems": 3,
                "maxItems": 3
              },
              "scale": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "pattern": "^="
                    }
                  ]
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "attach": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "anchor": {
                "enum": [
                  "center",
                  "left",
                  "right",
                  "front",
                  "back",
                  "bottom",
                  "top"
                ]
              },
              "target_anchor": {
                "enum": [
                  "center",
                  "left",
                  "right",
                  "front",
                  "back",
                  "bottom",
                  "top"
                ]
              },
              "offset": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "pattern": "^="
                    }
                  ]
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "target"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "path",
          "solid",
          "layer"
        ],
        "additionalProperties": false
      }
    },
    "assemblies": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "minItems": 1
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "minItems": 1
          },
          "mode": {
            "enum": [
              "union",
              "combine"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "members"
            ]
          },
          {
            "required": [
              "layers"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "project_version",
    "name",
    "units",
    "layers",
    "segments",
    "assemblies"
  ],
  "additionalProperties": false
}
