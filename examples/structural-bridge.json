{
  "version": 1,
  "units": "mm",
  "params": {"span": 40, "rise": 20, "leg": 18, "rib": 5, "depth": 8, "pitch": 20},
  "solids": {
    "deck": {"op": "panel", "size": [70, 55], "thickness": 4, "center": [0, 20, 2]},
    "arch": {"op": "arch", "span": "=span", "rise": "=rise", "leg": "=leg", "thickness": "=rib", "depth": "=depth", "origin": [0, 0, 3.8]},
    "ribs": {"op": "repeat", "input": "arch", "counts": [1, 3, 1], "step": [0, "=pitch", 0]},
    "left_rail": {"op": "beam", "start": [-24, 0, 25], "end": [-24, 40, 25], "size": [3, 3]},
    "right_rail": {"op": "beam", "start": [24, 0, 25], "end": [24, 40, 25], "size": [3, 3]},
    "bridge": {"op": "union", "inputs": ["deck", "ribs", "left_rail", "right_rail"]}
  },
  "exports": [{"solid": "bridge", "path": "structural-bridge.stl"}]
}
